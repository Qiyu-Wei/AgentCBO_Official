# Optional shell template. Load explicitly with: source .env.example
# These values configure an already running OpenAI-compatible local server.
export USE_VLLM=true
export VLLM_BASE_URL=http://localhost:8000/v1
export VLLM_MODEL=served-model-id

# For a cloud endpoint, set USE_VLLM=false and provide your own credentials.
# export OPENAI_API_BASE=https://api.openai.com/v1
# export OPENAI_API_KEY=
# export OPENAI_MODEL=gpt-4o-mini
